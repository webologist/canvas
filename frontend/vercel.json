{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://canvas-api.onrender.com/api/:path*" },
    { "source": "/media/:path*", "destination": "https://canvas-api.onrender.com/media/:path*" },
    { "source": "/static/:path*", "destination": "https://canvas-api.onrender.com/static/:path*" },
    { "source": "/admin/:path*", "destination": "https://canvas-api.onrender.com/admin/:path*" },
    { "source": "/sitemap.xml", "destination": "https://canvas-api.onrender.com/sitemap.xml" },
    { "source": "/((?!assets/|icons/).*)", "destination": "/index.html" }
  ]
}
