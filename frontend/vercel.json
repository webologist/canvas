{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://canvas-api-ypo8.onrender.com/api/$1" },
    { "source": "/media/(.*)", "destination": "https://canvas-api-ypo8.onrender.com/media/$1" },
    { "source": "/static/(.*)", "destination": "https://canvas-api-ypo8.onrender.com/static/$1" },
    { "source": "/admin/(.*)", "destination": "https://canvas-api-ypo8.onrender.com/admin/$1" },
    { "source": "/sitemap.xml", "destination": "https://canvas-api-ypo8.onrender.com/sitemap.xml" },
    { "source": "/((?!assets/|icons/).*)", "destination": "/index.html" }
  ]
}
